{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-shop-saas",
  "compatibility_date": "2026-09-11",
  "main": "src/worker/index.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public"
  },
  "vars": {
    // Public base URL of this Worker once deployed (used to build Mini App / deep links).
    "APP_URL": "https://telegram-shop-saas.mohammadi-itech.workers.dev",
    // Used to build t.me invite deep links — no leading @.
    "TELEGRAM_BOT_USERNAME": "panio_store_bot",
    // Zarinpal sandbox until a real merchant id secret is added — see DEPLOY.md.
    "ZARINPAL_SANDBOX": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "panio-db",
      "database_id": "8a137f9b-ff16-40e7-8586-79080d089ca2",
      "migrations_dir": "src/infrastructure/db/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "BOT_SESSIONS",
      "id": "097faa4d936c4f2996fc0be5a6341a20"
    }
  ],
  "triggers": {
    // Daily at 06:00 UTC — sweeps expired subscriptions and sends renewal reminders.
    "crons": ["0 6 * * *"]
  }
}
