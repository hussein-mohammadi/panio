{
  "name": "telegram-shop-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply panio-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply panio-db --remote",
    "db:seed:local": "wrangler d1 execute panio-db --local --file=./src/infrastructure/db/seed.sql",
    "db:seed:remote": "wrangler d1 execute panio-db --remote --file=./src/infrastructure/db/seed.sql"
  },
  "dependencies": {
    "grammy": "^1.30.0",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.131.1"
  }
}
